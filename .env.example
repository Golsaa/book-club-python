# Copy to .env and provide your own values. Never commit .env.
SESSION_SECRET=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///./data/bookclub.db
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback
COOKIE_SECURE=false

# Email is attempted only when SMTP_HOST and SMTP_FROM are configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# A recurring 14-day UTC schedule, anchored at the approved first opening.
VOTING_FIRST_START=2026-11-01T00:00:00+00:00
VOTING_PERIOD_DAYS=14