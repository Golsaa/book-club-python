# Copy to .env and provide your own values. Never commit .env.
SESSION_SECRET=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///./data/bookclub.db
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback
COOKIE_SECURE=false
ADMIN_EMAILS=admin@example.com

# Email is attempted only when SMTP_HOST and SMTP_FROM are configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# A recurring 2-day UTC schedule, anchored at the first opening.
VOTING_FIRST_START=2026-10-25T00:00:00+00:00
VOTING_PERIOD_DAYS=2
DEFAULT_GENRES=Fiction,Non-Fiction,Mystery,Sci-Fi,Fantasy
